{
  "manifest_version": 3,
  "name": "Floating AI Translator",
  "version": "1.1",
  "description": "Dịch văn bản nhanh chóng với widget nổi - hoạt động trên mọi trang web kể cả Facebook",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Floating AI Translator",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon128.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-widget": {
      "suggested_key": {
        "default": "Ctrl+Shift+T",
        "mac": "Command+Shift+T"
      },
      "description": "Toggle Floating Translator widget trên trang"
    }
  }
}

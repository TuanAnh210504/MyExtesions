{
  "manifest_version": 3,
  "name": "Quick Mini Search",
  "version": "1.0",
  "description": "Tìm kiếm nhanh văn bản hoặc hình ảnh trong cửa sổ popup thu nhỏ.",
  "permissions": [
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

<Window x:Class="NoteBookEng.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bubble" Height="64" Width="64"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False">
    
    <Border x:Name="BubbleBorder" Width="50" Height="50" CornerRadius="25"
            Background="#4F46E5" BorderBrush="#3B82F6" BorderThickness="2"
            Cursor="Hand"
            MouseLeftButtonDown="Border_MouseLeftButtonDown"
            MouseLeftButtonUp="Border_MouseLeftButtonUp"
            MouseMove="Border_MouseMove">
        
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.5"/>
        </Border.Effect>
        
        <!-- Book Icon -->
        <Viewbox Width="24" Height="24">
            <Path Data="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3M19 19H5V5H19V19M17 17H7V15H17V17M17 13H7V11H17V13M17 9H7V7H17V9Z" 
                  Fill="#FFFFFF" />
        </Viewbox>
    </Border>
</Window>

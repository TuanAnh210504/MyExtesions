<Window x:Class="NoteBookEng.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NoteBook Eng" 
        Height="490" 
        Width="350"
        MinHeight="440"
        MinWidth="330"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <!-- Outer window border with drop shadow -->
    <Border Background="{StaticResource BgBrush}" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" 
                              ShadowDepth="4" 
                              Direction="270" 
                              Color="#000000" 
                              Opacity="0.55" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Title bar -->
                <RowDefinition Height="38" />
                <!-- Content -->
                <RowDefinition Height="*" />
                <!-- Status bar -->
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- ================= HEADER / TITLE BAR ================= -->
            <Border Grid.Row="0" 
                    Background="#161822" 
                    CornerRadius="9,9,0,0" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="10,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Title & Icon -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                            <Path Data="M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3M19 19H5V5H19V19M17 17H7V15H17V17M17 13H7V11H17V13M17 9H7V7H17V9Z" 
                                  Fill="{StaticResource AccentHoverBrush}" />
                        </Viewbox>
                        <TextBlock Text="NoteBook Eng" 
                                   FontWeight="SemiBold" 
                                   FontSize="12" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Spacer for dragging -->
                    <Rectangle Grid.Column="1" Fill="Transparent" />

                    <!-- Window Action Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pin / Topmost Toggle Button -->
                        <Button x:Name="BtnPin" 
                                Style="{StaticResource WindowActionButton}" 
                                ToolTip="Toggle Always On Top"
                                Click="BtnPin_Click"
                                Margin="0,0,3,0">
                            <Viewbox Width="13" Height="13">
                                <Path x:Name="PathPin" 
                                      Data="M16,12V4H17V2H7V4H8V12L6,14V16H11V22H13V16H18V14L16,12Z" 
                                      Fill="{StaticResource AccentHoverBrush}" />
                            </Viewbox>
                        </Button>

                        <!-- Minimize Button -->
                        <Button Style="{StaticResource WindowActionButton}" 
                                ToolTip="Minimize"
                                Click="BtnMinimize_Click"
                                Margin="0,0,3,0">
                            <Viewbox Width="11" Height="11">
                                <Path Data="M4,11H16V13H4Z" Fill="{StaticResource TextSecondaryBrush}" />
                            </Viewbox>
                        </Button>

                        <!-- Close Button -->
                        <Button Style="{StaticResource WindowCloseButton}" 
                                ToolTip="Close"
                                Click="BtnClose_Click">
                            <Viewbox Width="10" Height="10">
                                <Path Data="M13.41,12L19,17.59L17.59,19L12,13.41L6.41,19L5,17.59L10.59,12L5,6.41L6.41,5L12,10.59L17.59,5L19,6.41L13.41,12Z" 
                                      Fill="{StaticResource TextSecondaryBrush}" />
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= MAIN BODY ================= -->
            <Grid Grid.Row="1" Margin="12,10,12,6">
                <Grid.RowDefinitions>
                    <!-- Input Section -->
                    <RowDefinition Height="Auto" />
                    <!-- Status / Match Badge -->
                    <RowDefinition Height="Auto" />
                    <!-- Meaning Input & Actions -->
                    <RowDefinition Height="Auto" />
                    <!-- Matches or Recent List -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Row 0: Word Input -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Border Background="{StaticResource SurfaceBrush}" 
                            BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="7" 
                            Padding="8,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Search icon -->
                            <Viewbox Grid.Column="0" Width="14" Height="14" Margin="2,0,8,0" VerticalAlignment="Center">
                                <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" 
                                      Fill="{StaticResource TextSecondaryBrush}" />
                            </Viewbox>

                            <!-- Word TextBox -->
                            <TextBox x:Name="TxtWord" 
                                     Grid.Column="1"
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     Foreground="{StaticResource TextPrimaryBrush}" 
                                     CaretBrush="#FFFFFF" 
                                     FontSize="13" 
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center"
                                     TextChanged="TxtWord_TextChanged"
                                     KeyDown="TxtWord_KeyDown" />

                            <!-- Placeholder -->
                            <TextBlock x:Name="TxtWordPlaceholder" 
                                       Grid.Column="1" 
                                       Text="Type an English word..." 
                                       Foreground="#64748B" 
                                       FontSize="13" 
                                       VerticalAlignment="Center" 
                                       IsHitTestVisible="False" />

                            <!-- Clear Button -->
                            <Button x:Name="BtnClearWord" 
                                    Grid.Column="2" 
                                    Style="{StaticResource WindowActionButton}" 
                                    Width="20" Height="20" 
                                    Visibility="Collapsed"
                                    Click="BtnClearWord_Click">
                                <TextBlock Text="✕" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 1: Search Status Indicator Badge -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Match Status Pill -->
                        <Border x:Name="PillStatus" 
                                CornerRadius="4" 
                                Padding="6,2" 
                                Background="#1F2937" 
                                BorderBrush="#374151" 
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="TxtStatusBadge" 
                                       FontSize="10" 
                                       FontWeight="Medium" 
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Section Header or count -->
                    <TextBlock x:Name="TxtListHeader" 
                               Grid.Column="1" 
                               Text="Recent Words" 
                               FontSize="11" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               VerticalAlignment="Center" />
                </Grid>

                <!-- Row 2: Meaning Input & Action Area -->
                <Border Grid.Row="2" 
                        Background="{StaticResource SurfaceBrush}" 
                        BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="7" 
                        Padding="8"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Meaning Text Area -->
                        <Grid Grid.Row="0">
                            <TextBox x:Name="TxtMeaning" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     Foreground="{StaticResource TextPrimaryBrush}" 
                                     CaretBrush="#FFFFFF" 
                                     FontSize="12" 
                                     MinHeight="44" 
                                     MaxHeight="120"
                                     TextWrapping="Wrap" 
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     TextChanged="TxtMeaning_TextChanged"
                                     KeyDown="TxtMeaning_KeyDown" />

                            <!-- Meaning Placeholder -->
                            <TextBlock x:Name="TxtMeaningPlaceholder" 
                                       Text="Vietnamese meaning (Press Enter to save)..." 
                                       Foreground="#64748B" 
                                       FontSize="12" 
                                       Margin="2,1,0,0"
                                       IsHitTestVisible="False" />
                        </Grid>

                        <!-- Actions bar below meaning input -->
                        <Grid Grid.Row="1" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Auto-Translate Button -->
                            <Button x:Name="BtnTranslate" 
                                    Grid.Column="0" 
                                    Style="{StaticResource SecondaryButton}" 
                                    ToolTip="Auto-translate word with Google Translate"
                                    Click="BtnTranslate_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="12" Height="12" Margin="0,0,5,0">
                                        <Path Data="M12.87,15.07L10.33,12.56L10.36,12.53C12.1,10.59 13.34,8.36 14.07,6H17V4H10V2H8V4H1V6H12.17C11.5,7.92 10.44,9.75 9,11.35C8.07,10.32 7.3,9.19 6.69,8H4.69C5.42,9.63 6.42,11.17 7.67,12.56L2.58,17.58L4,19L9,14L12.11,17.11L12.87,15.07M18.5,10H16.5L12,22H14L15.12,19H19.87L21,22H23L18.5,10M15.88,17L17.5,12.67L19.12,17H15.88Z" 
                                              Fill="{StaticResource AccentHoverBrush}" />
                                    </Viewbox>
                                    <TextBlock x:Name="TxtTranslateBtn" Text="Translate" FontSize="11" />
                                </StackPanel>
                            </Button>

                            <!-- Hint text -->
                            <TextBlock Grid.Column="1" 
                                       Text="↵ Enter to Save" 
                                       FontSize="10" 
                                       Foreground="#64748B" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Right" 
                                       Margin="0,0,8,0" />

                            <!-- Quick Add / Save Button -->
                            <Button x:Name="BtnSave" 
                                    Grid.Column="2" 
                                    Style="{StaticResource PrimaryButton}" 
                                    Click="BtnSave_Click"
                                    ToolTip="Save Word (Enter)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Save" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Row 3: Matches or Recent List -->
                <Border Grid.Row="3" 
                        Background="{StaticResource SurfaceBrush}" 
                        BorderBrush="{StaticResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="7" 
                        ClipToBounds="True">
                    <Grid>
                        <!-- List of items -->
                        <ListBox x:Name="ListResults" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="ListResults_SelectionChanged"
                                 Padding="4">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="itemBorder" 
                                                        Background="{TemplateBinding Background}" 
                                                        CornerRadius="5" 
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="#2A2D43" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Word}" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="12" 
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding ShortMeaning}" 
                                                       FontSize="11" 
                                                       Foreground="{StaticResource TextSecondaryBrush}" 
                                                       TextTrimming="CharacterEllipsis" 
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Delete action button -->
                                        <Button Grid.Column="1" 
                                                Style="{StaticResource WindowActionButton}" 
                                                Width="22" Height="22" 
                                                ToolTip="Delete Word" 
                                                Tag="{Binding Id}"
                                                Click="BtnDeleteItem_Click"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="✕" FontSize="9" Foreground="#64748B" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Empty state placeholder -->
                        <StackPanel x:Name="PanelEmptyState" 
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Center" 
                                    Visibility="Collapsed">
                            <TextBlock Text="📖" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="No words in notebook yet." 
                                       FontSize="12" 
                                       Foreground="#64748B" 
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Type above to search or add new words!" 
                                       FontSize="10" 
                                       Foreground="#475569" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= STATUS BAR / TOAST ================= -->
            <Border Grid.Row="2" 
                    Background="#111219" 
                    CornerRadius="0,0,9,9" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="0,1,0,0"
                    Padding="10,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtFooterStatus" 
                               Text="Ready" 
                               FontSize="10" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               VerticalAlignment="Center" />

                    <TextBlock x:Name="TxtWordCount" 
                               Grid.Column="1" 
                               Text="0 words" 
                               FontSize="10" 
                               Foreground="#64748B" 
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
